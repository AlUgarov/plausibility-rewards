@misc{gao_bf16_2026,
	title = {bf16 {Rounding} {Silently} {Discards} {Most} {RL} {Policy} {Updates}: {A} {Hidden} {Training}-{Inference} {Mismatch} and an {Unbiased} {One}-{Line} {Fix}},
	shorttitle = {bf16 {Rounding} {Silently} {Discards} {Most} {RL} {Policy} {Updates}},
	url = {http://arxiv.org/abs/2610.41073},
	doi = {10.48550/arXiv.2610.41073},
	abstract = {Reinforcement learning (RL) post-training of language models keeps fp32 master weights in the optimizer and serves rollouts from a bf16 copy produced by round-to-nearest conversion. At the learning rates in common use, most per-step updates are smaller than half a bf16 spacing and the conversion discards them: on Qwen3-1.7B only 0.4-0.5\% of served weights change per step, and the policy that generates the training data lags the optimizer by 50-150 steps. Existing mismatch corrections cannot see this lag because they compare two copies downstream of the same rounding. We propose Fair Cast: export the master with an unbiased rounding rule (stochastic rounding or error feedback) and compute the training loss on the served copy. The change is one line at the export call, adds no hyperparameters and costs 22-38 ms per export of 1.7B parameters. Across 25 matched seed-pairs on Qwen3-0.6B to 4B with AdamW and Muon, Fair Cast is ahead on 18, tied on 6 and behind on 1, with a mean gain of 6.1 points; on zebra puzzles it reaches 0.57 +/- 0.16 over four runs where round-to-nearest collapses to 0.33 +/- 0.10. It also makes the saved fp32 checkpoint agree with the served model, and it exposes the implicit lag of round-to-nearest as a regularizer that can be restored explicitly when a task needs it.},
	urldate = {2026-11-03},
	publisher = {arXiv},
	author = {Gao, Andrew and Gao, William},
	month = oct,
	year = {2026},
	note = {arXiv:2610.41073 [cs.LG]},
	keywords = {Computer Science - Artificial Intelligence, Computer Science - Machine Learning},
	file = {Preprint PDF:/Users/alexander/Zotero/storage/56T85R5H/Gao and Gao - 2026 - bf16 Rounding Silently Discards Most RL Policy Updates A Hidden Training-Inference Mismatch and an.pdf:application/pdf;Snapshot:/Users/alexander/Zotero/storage/BZYAVV37/2610.html:text/html},
}

@misc{chen_statistical_2026,
	title = {Statistical {Foundations} of {Reinforcement} {Learning}: {A} {Non}-{Asymptotic} {Perspective}},
	shorttitle = {Statistical {Foundations} of {Reinforcement} {Learning}},
	url = {http://arxiv.org/abs/2610.41903},
	doi = {10.48550/arXiv.2610.41903},
	abstract = {Reinforcement learning (RL) embodies a foundational paradigm for sequential decision-making in the face of uncertainty. The rapid growth of model complexity in emerging applications has significantly amplified the challenges of achieving data-efficient RL, particularly in sample-starved scenarios where data collection may be costly, time-consuming, or even high-stakes. Consequently, understanding and improving the data efficiency of RL algorithms has become a central problem of both fundamental theoretical interest and practical importance. Despite decades of research, the statistical underpinnings of RL remained remarkably underdeveloped until relatively recently, particularly in the finite-sample regimes most relevant to modern practice. Over the past few years, there has been a surge of activity advancing the frontiers of non-asymptotic statistical RL theory, drawing on ideas from high-dimensional statistics and probability, information theory, and statistical learning theory. In this monograph, we present a non-asymptotic treatment for RL based on tabular Markov decision processes, focusing on three canonical sampling mechanisms --- RL with a generative model, online RL, and offline RL --- together with two algorithmic paradigms: model-based and model-free approaches. Centered around non-asymptotic sample complexity analysis, our treatment emphasizes minimax-optimal algorithm design, particularly methods that attain statistical optimality without significant burn-in costs, as well as sharp statistical characterizations of several widely used RL algorithms. Whenever possible, we provide largely self-contained analyses together with intuitive explanations. We also briefly discuss several extensions, such as robust RL, competitive multi-agent RL, federated RL, uncertainty quantification, and RL from human feedback.},
	urldate = {2026-11-03},
	publisher = {arXiv},
	author = {Chen, Yuxin and Chi, Yuejie and Fan, Jianqing and Li, Gen and Wei, Yuting and Yan, Yuling},
	month = oct,
	year = {2026},
	note = {arXiv:2610.41903 [stat.ML]},
	keywords = {Computer Science - Information Theory, Computer Science - Machine Learning, Statistics - Machine Learning},
	file = {Preprint PDF:/Users/alexander/Zotero/storage/2RKUINT4/Chen et al. - 2026 - Statistical Foundations of Reinforcement Learning A Non-Asymptotic Perspective.pdf:application/pdf;Snapshot:/Users/alexander/Zotero/storage/I88TLYT7/2610.html:text/html},
}

@misc{bay_grpo_2026,
	title = {{GRPO}, {Dr}. {GRPO}, and {DAPO} {Are} {Three} {Operations} on {One} {Number}: {The} {Group}-{Standard}-{Deviation} {Identity}},
	shorttitle = {{GRPO}, {Dr}. {GRPO}, and {DAPO} {Are} {Three} {Operations} on {One} {Number}},
	url = {http://arxiv.org/abs/2607.00152},
	doi = {10.48550/arXiv.2607.00152},
	abstract = {Three of the most popular methods for training language models to reason look like three different tricks. They are not. All three adjust a single number: standard deviation, reflecting how much a prompt's sampled answers disagree. When such a model is trained, it answers each problem many times, and an automatic checker marks every answer right or wrong. The standard deviation of those marks measures the disagreement: largest when the answers split evenly between right and wrong, and zero when they all agree. Group Relative Policy Optimization (GRPO) divides by this number, GRPO Done Right (Dr. GRPO) drops the division, and Decoupled Clip and Dynamic Sampling Policy Optimization (DAPO) discards the groups where it is zero. Each is presented as its own fix, yet this paper proves they are three settings of one dial. That dial is not cosmetic: for right-or-wrong rewards, the disagreement is exactly the size of the training update, the group-standard-deviation identity. A split group teaches the most, while a unanimous group teaches nothing and falls silent. The same result says which problems deserve the most weight and how many tries each one needs. This paper confirms the intuition on a large real difficulty dataset (Big-Math) and in a controlled training run. What looks like a harmless normalization step is the dial that decides where learning happens and how strongly.},
	urldate = {2026-11-03},
	publisher = {arXiv},
	author = {Bay, Yong Yi and Yearick, Kathleen A.},
	month = jun,
	year = {2026},
	note = {arXiv:2607.00152 [cs.LG]},
	keywords = {Computer Science - Artificial Intelligence, Computer Science - Computation and Language, Computer Science - Machine Learning, Statistics - Machine Learning},
	annote = {Comment: 18 pages, 10 figures, 4 tables. Code and data: https://github.com/bay-yearick-lab/grpo-standard-deviation-identity},
	file = {Preprint PDF:/Users/alexander/Zotero/storage/QNWA5PMQ/Bay and Yearick - 2026 - GRPO, Dr. GRPO, and DAPO Are Three Operations on One Number The Group-Standard-Deviation Identity.pdf:application/pdf;Snapshot:/Users/alexander/Zotero/storage/XC5FRZD2/2607.html:text/html},
}

@misc{chen_noise_2024,
	title = {Noise {Contrastive} {Alignment} of {Language} {Models} with {Explicit} {Rewards}},
	url = {http://arxiv.org/abs/2402.05369},
	doi = {10.48550/arXiv.2402.05369},
	abstract = {User intentions are typically formalized as evaluation rewards to be maximized when fine-tuning language models (LMs). Existing alignment methods, such as Direct Preference Optimization (DPO), are mainly tailored for pairwise preference data where rewards are implicitly defined rather than explicitly given. In this paper, we introduce a general framework for LM alignment, leveraging Noise Contrastive Estimation (NCE) to bridge the gap in handling reward datasets explicitly annotated with scalar evaluations. Our framework comprises two parallel algorithms, NCA and InfoNCA, both enabling the direct extraction of an LM policy from reward data as well as preference data. Notably, we show that the DPO loss is a special case of our proposed InfoNCA objective under pairwise preference settings, thereby integrating and extending current alignment theories. By comparing NCA and InfoNCA, we demonstrate that the well-observed decreasing-likelihood trend of DPO/InfoNCA is caused by their focus on adjusting relative likelihood across different responses. In contrast, NCA optimizes the absolute likelihood for each response, thereby effectively preventing the chosen likelihood from decreasing. We evaluate our methods in both reward and preference settings with Mistral-8*7B and 7B models. Experiments suggest that InfoNCA/NCA surpasses various preference baselines when reward datasets are available. We also find NCA significantly outperforms DPO in complex reasoning tasks like math and coding.},
	urldate = {2026-11-05},
	publisher = {arXiv},
	author = {Chen, Huayu and He, Guande and Yuan, Lifan and Cui, Ganqu and Su, Hang and Zhu, Jun},
	month = oct,
	year = {2024},
	note = {arXiv:2402.05369 [cs.LG]},
	keywords = {Computer Science - Computation and Language, Computer Science - Machine Learning},
	annote = {Comment: NeurIPS 2024},
	file = {Preprint PDF:/Users/alexander/Zotero/storage/8PN3EQA5/Chen et al. - 2024 - Noise Contrastive Alignment of Language Models with Explicit Rewards.pdf:application/pdf;Snapshot:/Users/alexander/Zotero/storage/AKUGFZPH/2402.html:text/html},
}

@misc{chang_rufus-air_2026,
	title = {Rufus-{Air}: {An} {Open} {LLM} {Post}-{Training} {Recipe}},
	shorttitle = {Rufus-{Air}},
	url = {http://arxiv.org/abs/2609.29421},
	doi = {10.48550/arXiv.2609.29421},
	abstract = {Rufus-Air is an open and reproducible post-training recipe on GLM-4.5-Air-Base (106B-A12B), organized as a serial pipeline of eight stages: SFT, Reasoning RL, Coding RL, Instruction-Following RL, General Agent, Coding Agent, Search Agent, and RLHF. We document the data, reward design, infrastructure, stage order, and stagewise results needed to reproduce the recipe. Stages progress from basic to advanced capabilities and from hard, verifiable rewards to softer judge-based signals. Training builds on open-source components and public data, much of it used as released, without new human annotation or an in-house distillation teacher. Our main findings are that (i) diverse, high-quality SFT establishes a strong capability floor; (ii) difficulty filtering keeps RL prompts within a productive learning range; (iii) reward reliability provides a practical principle for ordering stages; and (iv) infrastructure and engineering choices are part of the recipe, not just an implementation detail. Rufus-Air improves over the official GLM-4.5-Air post-trained release and is competitive with similarly sized open models.},
	urldate = {2026-11-05},
	publisher = {arXiv},
	author = {Chang, Chia-Yuan and Cheng, Renyuan and Feng, Rui and Han, Xiaotian and He, Yuan and Jin, Hongye and Li, Linwei and Li, Shiyang and Liu, Fenglin and Liu, Xin and Nigam, Priyanka and Wen, Haoyang and Xu, Zhenghao and Xu, Zhuocheng and Yin, Bing and Yin, Qingyu and Zhang, Chao and Zhang, Rongzhi and Zhang, Zhihan and Zhang, Zixuan and Zhang, Zixuan and Zhao, Tuo},
	month = sep,
	year = {2026},
	note = {arXiv:2609.29421 [cs.CL]},
	keywords = {Computer Science - Artificial Intelligence, Computer Science - Computation and Language, Computer Science - Machine Learning},
	annote = {Comment: 48 pages, 9 figures, 20 tables. Authors are listed alphabetically by surname; all contributed while at Amazon. The two authors named Zixuan Zhang are different people},
	file = {Preprint PDF:/Users/alexander/Zotero/storage/3QQ6KR34/Chang et al. - 2026 - Rufus-Air An Open LLM Post-Training Recipe.pdf:application/pdf;Snapshot:/Users/alexander/Zotero/storage/3DM3AQCL/2609.html:text/html},
}
